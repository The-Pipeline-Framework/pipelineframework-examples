<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.pipelineframework.restaurantapproval</groupId>
    <artifactId>restaurant-approval</artifactId>
    <version>26.9.4-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>restaurant-approval-worker</artifactId>
  <name>Restaurant Approval pinned REST worker</name>
  <properties>
    <pipeline.generatedSourcesArg>-Apipeline.generatedSourcesDir=${project.build.directory}/generated-sources/pipeline</pipeline.generatedSourcesArg>
    <pipeline.moduleArg>-Apipeline.module=monolith-svc</pipeline.moduleArg>
    <tpf.build.transport>LOCAL</tpf.build.transport>
    <restaurant.release.version>restaurant-hosted-local-1</restaurant.release.version>
    <tpf.release.skip>true</tpf.release.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.pipelineframework.restaurantapproval</groupId>
      <artifactId>common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.pipelineframework</groupId>
      <artifactId>pipelineframework</artifactId>
      <version>${pipelineframework.runtime.version}</version>
    </dependency>
    <dependency>
      <groupId>org.pipelineframework</groupId>
      <artifactId>pipelineframework-aws-durable-coordination-host</artifactId>
      <version>${restaurant.worker.host.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-amazon-lambda-http</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>same-authored-services</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../validate-order-request-svc/src/main/java</source>
                <source>${project.basedir}/../create-pending-approval-svc/src/main/java</source>
                <source>${project.basedir}/../finalize-restaurant-decision-svc/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths combine.self="override">
            <path>
              <groupId>org.pipelineframework</groupId>
              <artifactId>pipelineframework-compiler</artifactId>
              <version>${pipelineframework.compiler.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <execution>
            <id>default-compile</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <compilerArgs combine.self="override">
                <arg>-Apipeline.config=${project.basedir}/../config/pipeline.yaml</arg>
                <arg>-Apipeline.module=monolith-svc</arg>
                <arg>-Apipeline.moduleDir=${project.basedir}/../monolith-svc</arg>
                <arg>-Apipeline.generatedSourcesDir=${project.build.directory}/generated-sources/pipeline</arg>
                <arg>-Apipeline.transport=LOCAL</arg>
                <arg>-Apipeline.platform=COMPUTE</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.pipelineframework</groupId>
        <artifactId>pipelineframework-release-maven-plugin</artifactId>
        <version>${restaurant.release.plugin.version}</version>
        <!-- Plugin resolution has its own dependency graph; pin its reader closure too. -->
        <dependencies>
          <dependency>
            <groupId>org.pipelineframework</groupId><artifactId>pipelineframework-api</artifactId>
            <version>${restaurant.contracts.version}</version>
          </dependency>
          <dependency>
            <groupId>org.pipelineframework</groupId><artifactId>pipelineframework-dsl</artifactId>
            <version>${restaurant.contracts.version}</version>
          </dependency>
          <dependency>
            <groupId>org.pipelineframework</groupId><artifactId>pipelineframework-runtime-api</artifactId>
            <version>${restaurant.contracts.version}</version>
          </dependency>
          <dependency>
            <groupId>org.pipelineframework</groupId><artifactId>pipelineframework-runtime-core</artifactId>
            <version>${restaurant.contracts.version}</version>
          </dependency>
          <dependency>
            <groupId>org.pipelineframework</groupId><artifactId>pipelineframework-runtime-protocol</artifactId>
            <version>${restaurant.contracts.version}</version>
          </dependency>
          <dependency>
            <groupId>org.pipelineframework</groupId><artifactId>pipelineframework-runtime-serialization</artifactId>
            <version>${restaurant.contracts.version}</version>
          </dependency>
          <dependency>
            <groupId>org.pipelineframework</groupId><artifactId>pipelineframework-runtime-spi</artifactId>
            <version>${restaurant.contracts.version}</version>
          </dependency>
          <dependency>
            <groupId>org.pipelineframework</groupId><artifactId>pipelineframework-semantic-model</artifactId>
            <version>${restaurant.contracts.version}</version>
          </dependency>
          <dependency>
            <groupId>org.pipelineframework</groupId><artifactId>representation-provider-api</artifactId>
            <version>${restaurant.contracts.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <skip>${tpf.release.skip}</skip>
          <allowLocalUris>true</allowLocalUris>
          <artifactKind>lambda-zip</artifactKind>
          <artifactFile>${project.build.directory}/function.zip</artifactFile>
          <releaseVersion>${restaurant.release.version}</releaseVersion>
          <artifactId>restaurant-worker</artifactId>
          <deployment>
            <profile>aws-durable-java21-rest-worker-v1</profile>
            <entries>
              <entry>
                <entryId>restaurant-worker</entryId>
                <artifactId>restaurant-worker</artifactId>
                <runtimeId>monolith-svc</runtimeId>
                <packagePath>.</packagePath>
                <entryClass>io.quarkus.amazon.lambda.http.LambdaHttpHandler</entryClass>
                <entryPackagePath>lib/io.quarkus.quarkus-amazon-lambda-http-${quarkus.platform.version}.jar</entryPackagePath>
                <trigger>AWS_DURABLE_REST_WORKER</trigger>
              </entry>
            </entries>
          </deployment>
        </configuration>
        <executions>
          <execution>
            <id>produce-worker-release</id>
            <phase>verify</phase>
            <goals>
              <goal>generate-release-descriptor</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>